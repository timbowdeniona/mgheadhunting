{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "MG Headhunting Design Tokens",
  "version": "1.0.0",
  "description": "Design tokens for MG Headhunting (MGH) - Boutique Executive Search in Building Products & Construction",
  "color": {
    "brand": {
      "navy": {
        "950": { "$value": "#07111D", "$type": "color", "$description": "Deepest architectural slate" },
        "900": { "$value": "#0F243A", "$type": "color", "$description": "Primary high-emphasis text and deep surface" },
        "800": { "$value": "#163A5F", "$type": "color", "$description": "Primary Brand Navy - Authority, seniority, calm, industrial gravitas" },
        "700": { "$value": "#1E4C7A", "$type": "color", "$description": "Active/Hover Navy" },
        "600": { "$value": "#2A649E", "$type": "color", "$description": "Medium Navy accent" },
        "500": { "$value": "#3D7DC0", "$type": "color", "$description": "Navy tint" },
        "300": { "$value": "#8BB4DF", "$type": "color", "$description": "Light Navy tone" },
        "100": { "$value": "#D8E6F5", "$type": "color", "$description": "Subtle Navy wash" },
        "50":  { "$value": "#F1F6FB", "$type": "color", "$description": "Subtlest Navy canvas" }
      },
      "teal": {
        "900": { "$value": "#094648", "$type": "color", "$description": "Deepest teal tone" },
        "800": { "$value": "#0D5F61", "$type": "color", "$description": "Dark teal hover state" },
        "600": { "$value": "#138D90", "$type": "color", "$description": "Accent Medium Teal - Precision micro-accents, CTAs, divider strokes" },
        "500": { "$value": "#17A9AC", "$type": "color", "$description": "Teal interactive hover" },
        "400": { "$value": "#22C8CB", "$type": "color", "$description": "Vibrant metric accent" },
        "200": { "$value": "#8CE5E7", "$type": "color", "$description": "Soft teal indicator" },
        "100": { "$value": "#D2F5F6", "$type": "color", "$description": "Light teal badge backdrop" },
        "50":  { "$value": "#F0FBFC", "$type": "color", "$description": "Subtle teal background tint" }
      },
      "steel": {
        "900": { "$value": "#252B2E", "$type": "color", "$description": "Engineering dark grey" },
        "700": { "$value": "#4B5458", "$type": "color", "$description": "Secondary editorial text" },
        "500": { "$value": "#7A858A", "$type": "color", "$description": "Muted metadata & caption text" },
        "400": { "$value": "#A9B2B6", "$type": "color", "$description": "Medium structural line" },
        "300": { "$value": "#D0D4D6", "$type": "color", "$description": "Structural Neutral Concrete / Steel Grey - Hairline borders and grid guides" },
        "200": { "$value": "#E2E5E7", "$type": "color", "$description": "Subtle secondary border" },
        "100": { "$value": "#EFF1F2", "$type": "color", "$description": "Architectural wash surface" },
        "50":  { "$value": "#F8FAFB", "$type": "color", "$description": "Off-white architectural canvas" }
      }
    },
    "canvas": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "surface-light": { "$value": "#F8FAFB", "$type": "color" },
      "surface-muted": { "$value": "#F1F4F5", "$type": "color" },
      "surface-dark": { "$value": "#0F243A", "$type": "color" },
      "surface-darker": { "$value": "#081523", "$type": "color" }
    },
    "semantic": {
      "text": {
        "primary": { "$value": "{color.brand.navy.900}", "$type": "color" },
        "secondary": { "$value": "{color.brand.steel.700}", "$type": "color" },
        "muted": { "$value": "{color.brand.steel.500}", "$type": "color" },
        "inverse": { "$value": "#FFFFFF", "$type": "color" },
        "inverse-muted": { "$value": "{color.brand.steel.300}", "$type": "color" }
      },
      "border": {
        "structural": { "$value": "{color.brand.steel.300}", "$type": "color" },
        "subtle": { "$value": "{color.brand.steel.200}", "$type": "color" },
        "accent": { "$value": "{color.brand.teal.600}", "$type": "color" },
        "dark": { "$value": "rgba(208, 212, 214, 0.15)", "$type": "color" }
      },
      "cta": {
        "primary-bg": { "$value": "{color.brand.teal.600}", "$type": "color" },
        "primary-hover": { "$value": "{color.brand.teal.800}", "$type": "color" },
        "primary-text": { "$value": "#FFFFFF", "$type": "color" },
        "secondary-bg": { "$value": "{color.brand.navy.800}", "$type": "color" },
        "secondary-hover": { "$value": "{color.brand.navy.900}", "$type": "color" },
        "secondary-text": { "$value": "#FFFFFF", "$type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": {
        "$value": ["'Space Grotesk'", "'Plus Jakarta Sans'", "system-ui", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Modern architectural geometric sans for H1-H3 headers and monograms"
      },
      "sans": {
        "$value": ["'Inter'", "'Public Sans'", "system-ui", "-apple-system", "sans-serif"],
        "$type": "fontFamily",
        "$description": "Crisp, neutral sans-serif for body and editorial copy"
      },
      "mono": {
        "$value": ["'JetBrains Mono'", "'SF Mono'", "Consolas", "monospace"],
        "$type": "fontFamily",
        "$description": "Technical coordinates, indices, metrics, and engineering labels"
      }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "lineHeight": "1rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "lineHeight": "1.35rem", "$type": "dimension" },
      "base": { "$value": "1rem", "lineHeight": "1.65rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "lineHeight": "1.75rem", "$type": "dimension" },
      "xl": { "$value": "1.25rem", "lineHeight": "1.85rem", "$type": "dimension" },
      "2xl": { "$value": "1.5rem", "lineHeight": "2rem", "$type": "dimension" },
      "3xl": { "$value": "1.875rem", "lineHeight": "2.25rem", "$type": "dimension" },
      "4xl": { "$value": "2.25rem", "lineHeight": "2.6rem", "$type": "dimension" },
      "5xl": { "$value": "3rem", "lineHeight": "3.3rem", "$type": "dimension" },
      "6xl": { "$value": "3.75rem", "lineHeight": "4rem", "$type": "dimension" }
    },
    "letterSpacing": {
      "tighter": { "$value": "-0.04em", "$type": "dimension" },
      "tight": { "$value": "-0.02em", "$type": "dimension" },
      "normal": { "$value": "0em", "$type": "dimension" },
      "wide": { "$value": "0.04em", "$type": "dimension" },
      "wider": { "$value": "0.08em", "$type": "dimension" },
      "widest": { "$value": "0.15em", "$type": "dimension" },
      "ultra": { "$value": "0.22em", "$type": "dimension" }
    },
    "fontWeight": {
      "light": { "$value": "300", "$type": "fontWeight" },
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "semibold": { "$value": "600", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" }
    }
  },
  "radii": {
    "none": { "$value": "0px", "$type": "dimension", "$description": "Strict architectural 90-degree corners" },
    "sm": { "$value": "2px", "$type": "dimension", "$description": "Subtle precision micro-radius" },
    "md": { "$value": "4px", "$type": "dimension", "$description": "Maximum allowed radius for UI controls" }
  },
  "borderWidth": {
    "hairline": { "$value": "1px", "$type": "dimension", "$description": "Precision engineered 1px structural line" },
    "accent": { "$value": "2px", "$type": "dimension", "$description": "Active state or focus highlight" },
    "thick": { "$value": "4px", "$type": "dimension", "$description": "Section framing marker" }
  },
  "elevation": {
    "none": { "$value": "none", "$type": "shadow" },
    "subtle": { "$value": "0 1px 2px 0 rgba(15, 36, 58, 0.05)", "$type": "shadow" },
    "architectural": { "$value": "0 4px 12px -2px rgba(15, 36, 58, 0.08)", "$type": "shadow" },
    "flat-offset": { "$value": "3px 3px 0px 0px #D0D4D6", "$type": "shadow", "$description": "Engineered flat offset stroke" }
  },
  "grid": {
    "blueprint": {
      "size": { "$value": "32px", "$type": "dimension" },
      "lineColor": { "$value": "rgba(208, 212, 214, 0.35)", "$type": "color" }
    }
  }
}
